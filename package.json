{
  "name": "janubhaicoffee",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext mjs,js,jsx,ts,tsx",
    "lint:fix": "eslint . --ext mjs,js,jsx,ts,tsx --fix",
    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,mjs}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,mjs}\"",
    "type-check": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "analyze": "npx next build --analyze",
    "check": "npm run lint && npm run type-check && npm run test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.40.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "razorpay": "^2.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "resend": "^6.14.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.0",
    "tailwindcss": "^4",
    "vitest": "^4.1.9"
  }
}
